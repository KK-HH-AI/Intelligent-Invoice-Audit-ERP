# API密钥配置示例
# 复制此文件为.env并填入实际的API密钥

# PaddleOCR API配置
PADDLE_OCR_MODEL_DIR=./models
PADDLE_OCR_DET_MODEL=your_det_model
PADDLE_OCR_REC_MODEL=your_rec_model
PADDLE_OCR_CLS_MODEL=your_cls_model

# deepseek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat

# 本地模型API配置
LOCAL_MODEL_API_URL=http://localhost:8000/api/analyze