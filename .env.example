# API密钥配置示例
# 复制此文件为.env并填入实际的API密钥

# PaddleOCR API配置
PADDLE_OCR_MODEL_DIR=./ocr_models
PADDLE_OCR_DET_MODEL=your_det_model
PADDLE_OCR_REC_MODEL=your_rec_model
PADDLE_OCR_CLS_MODEL=your_cls_model

# deepseek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat

# 本地模型API配置
LOCAL_MODEL_API_URL=http://localhost:8000/api/analyze

# JWT 鉴权
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_DAYS=7
# AI 模拟开关：1=模拟模式（不调真实 OCR/DeepSeek），0=真实链路
AI_MOCK=1
